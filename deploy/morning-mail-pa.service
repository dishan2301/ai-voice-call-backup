[Unit]
Description=Morning Mail PA personal email briefing
Documentation=file://%h/dishan/morning-mail-pa/README.md
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dishan/morning-mail-pa
EnvironmentFile=-%h/dishan/morning-mail-pa/.env
Environment=PYTHONTZPATH=/usr/share/zoneinfo
Environment=XAUTHORITY=%h/.Xauthority
PassEnvironment=DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR
ExecStart=%h/dishan/morning-mail-pa/.venv311/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8765 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/dishan/morning-mail-pa/data %h/dishan/morning-mail-pa/secrets

[Install]
WantedBy=default.target
